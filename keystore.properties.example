# 이 파일을 복사해서 keystore.properties로 이름을 바꾸고 값을 채웁니다.
# keystore.properties는 .gitignore에 있어서 커밋되지 않습니다. 이 example 파일만 저장소에 올라갑니다.
#
# storeFile: 업로드 키 파일 위치. 저장소 밖(예: 홈 폴더)에 두는 것을 권장합니다.
storeFile=/Users/<사용자이름>/keystores/subday-upload.jks
storePassword=<키 저장소 비밀번호>
keyAlias=upload
keyPassword=<키 비밀번호>
