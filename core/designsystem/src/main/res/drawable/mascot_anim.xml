<?xml version="1.0" encoding="utf-8"?>
<!--
    애니메이션용 망고 그림. 앱 아이콘과 같은 그림이지만 움직일 부분에 이름(android:name)이 붙어 있습니다.
    - character: 망고 + 동전 (스플래시에서 톡 튀어나옴)
    - bubble_pop: "D-1" 말풍선 크기 (처음엔 0이라 안 보임)
    - bubble_ring: 말풍선 흔들림 (띠딩)
    실제 움직임은 avd_splash.xml, avd_bubble_ding.xml에 있습니다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 망고 + 동전 + 그림자 묶음. 스플래시에서 바닥(54, 84)을 기준으로 커지며 등장 -->
    <group android:name="character" android:pivotX="54" android:pivotY="84">
        <!-- 바닥 그림자 -->
        <group android:translateX="54" android:translateY="83" android:scaleY="0.18">
            <path android:pathData="M-27,0a27,27 0,1 0,54 0a27,27 0,1 0,-54 0z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="radial" android:centerX="0" android:centerY="0" android:gradientRadius="27">
                        <item android:offset="0" android:color="#4C8A3B00" />
                        <item android:offset="1" android:color="#008A3B00" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- 큰 ₩ 동전 -->
        <group android:translateX="68.5" android:translateY="63">
            <!-- 옆면 (오른쪽으로 두께) -->
            <path android:pathData="M-14.5,0a17,17 0,1 0,34 0a17,17 0,1 0,-34 0z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="-17" android:startY="0" android:endX="20" android:endY="0">
                        <item android:offset="0" android:color="#FFE69500" />
                        <item android:offset="1" android:color="#FFA85400" />
                    </gradient>
                </aapt:attr>
            </path>
            <!-- 앞면 -->
            <path android:pathData="M-17,0a17,17 0,1 0,34 0a17,17 0,1 0,-34 0z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="radial" android:centerX="-5" android:centerY="-6" android:gradientRadius="20">
                        <item android:offset="0" android:color="#FFFFF3B0" />
                        <item android:offset="0.5" android:color="#FFFFCA28" />
                        <item android:offset="1" android:color="#FFE08A00" />
                    </gradient>
                </aapt:attr>
            </path>
            <!-- 안쪽 테두리 -->
            <path android:strokeColor="#D88A00" android:strokeWidth="1.3" android:strokeAlpha="0.6" android:strokeLineCap="round" android:pathData="M-13,0a13,13 0,1 0,26 0a13,13 0,1 0,-26 0z" />
            <!-- ₩ -->
            <path android:strokeColor="#B86400" android:strokeWidth="2.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M-6.8,-6.8L-3.4,6.8L0,-2.3L3.4,6.8L6.8,-6.8" />
            <path android:strokeColor="#B86400" android:strokeWidth="1.7" android:strokeLineCap="round" android:pathData="M-9,-0.7h18M-9,3.1h18" />
            <!-- 빛 반사 -->
            <path android:strokeColor="#FFFFFF" android:strokeWidth="2.2" android:strokeAlpha="0.8" android:strokeLineCap="round" android:pathData="M-11,-7c2.2,-4 5.8,-6.3 9.8,-6.8" />
        </group>

        <!-- 동전에 기댄 망고 -->
        <group android:translateX="40" android:translateY="61" android:rotation="10">
            <!-- 몸통과 잎만 14도 기울임 (얼굴은 똑바로) -->
            <group android:rotation="-14">
                <!-- 몸통: 왼쪽 위가 밝은 노랑 -->
                <path android:pathData="M3,-24C15,-23 21,-10 19,5C17,17 7,24 -4,23C-13,22 -19,13 -19,1C-19,-13 -10,-24.5 3,-24z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="radial" android:centerX="-7" android:centerY="-11" android:gradientRadius="34">
                            <item android:offset="0" android:color="#FFFFF8B0" />
                            <item android:offset="0.4" android:color="#FFFFC928" />
                            <item android:offset="0.75" android:color="#FFFF9800" />
                            <item android:offset="1" android:color="#FFFF8A00" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- 꼭지 쪽 연두빛 (같은 모양을 한 번 더 겹쳐 칠함) -->
                <path android:pathData="M3,-24C15,-23 21,-10 19,5C17,17 7,24 -4,23C-13,22 -19,13 -19,1C-19,-13 -10,-24.5 3,-24z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="radial" android:centerX="4" android:centerY="-24" android:gradientRadius="16">
                            <item android:offset="0" android:color="#BF9CCC65" />
                            <item android:offset="1" android:color="#009CCC65" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- 아래쪽 붉은 홍조 -->
                <path android:pathData="M3,-24C15,-23 21,-10 19,5C17,17 7,24 -4,23C-13,22 -19,13 -19,1C-19,-13 -10,-24.5 3,-24z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="radial" android:centerX="12" android:centerY="16" android:gradientRadius="18">
                            <item android:offset="0" android:color="#B2F4511E" />
                            <item android:offset="1" android:color="#00F4511E" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- 꼭지 -->
                <path android:strokeColor="#6D4C41" android:strokeWidth="1.8" android:strokeLineCap="round" android:pathData="M3,-23.5l0.8,-4.5" />
                <!-- 잎 -->
                <path android:pathData="M4,-26C7,-33 16,-34 21,-30C16,-25 10,-24 4,-26z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="linear" android:startX="4" android:startY="-27" android:endX="18" android:endY="-19">
                            <item android:offset="0" android:color="#FFAED581" />
                            <item android:offset="1" android:color="#FF4E8A2A" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- 잎맥 -->
                <path android:strokeColor="#E8F5C8" android:strokeWidth="0.7" android:strokeAlpha="0.8" android:strokeLineCap="round" android:pathData="M6,-26.5C10,-28.5 14,-29.5 18,-29.8" />
            </group>
            <!-- 빛 반사 -->
            <path android:strokeColor="#FFFFFF" android:strokeWidth="2.4" android:strokeAlpha="0.75" android:strokeLineCap="round" android:pathData="M-13,-12c2,-4 5.5,-6.5 9.5,-7.2" />
            <!-- 눈 -->
            <path android:fillColor="#3E2723" android:pathData="M-8.6,-3a2.1,2.9 0,1 0,4.2 0a2.1,2.9 0,1 0,-4.2 0zM4.4,-3a2.1,2.9 0,1 0,4.2 0a2.1,2.9 0,1 0,-4.2 0z" />
            <!-- 눈 반짝임 -->
            <path android:fillColor="#FFFFFF" android:pathData="M-6.6,-4a0.8,0.8 0,1 0,1.6 0a0.8,0.8 0,1 0,-1.6 0zM6.4,-4a0.8,0.8 0,1 0,1.6 0a0.8,0.8 0,1 0,-1.6 0z" />
            <!-- 볼 터치 -->
            <path android:fillColor="#FF5A36" android:fillAlpha="0.45" android:pathData="M-15.2,2.5a3.2,1.9 0,1 0,6.4 0a3.2,1.9 0,1 0,-6.4 0zM8.8,2.5a3.2,1.9 0,1 0,6.4 0a3.2,1.9 0,1 0,-6.4 0z" />
            <!-- 웃는 입 -->
            <path android:strokeColor="#3E2723" android:strokeWidth="1.4" android:strokeLineCap="round" android:pathData="M-2.6,1.8q2.6,2.8 5.2,0" />
            <!-- 동전을 짚은 손 -->
            <path android:fillColor="#FF9800" android:pathData="M11.6,6a3.4,2.8 0,1 0,6.8 0a3.4,2.8 0,1 0,-6.8 0z" />
        </group>
    </group>

    <!-- "D-1" 말풍선 위치 -->
    <group android:translateX="67.5" android:translateY="35.5" android:scaleX="0.95" android:scaleY="0.95">
        <!-- 튀어나옴 담당: 처음에는 크기 0(안 보임) → 애니메이션으로 커짐 -->
        <group android:name="bubble_pop" android:scaleX="0" android:scaleY="0">
            <!-- 흔들림(띠딩) 담당: 말풍선 꼬리 근처를 축으로 좌우로 기울어짐 -->
            <group android:name="bubble_ring" android:pivotX="-4" android:pivotY="6">
                <!-- 흰 테두리 (같은 말풍선을 조금 크게) -->
                <group android:scaleX="1.12" android:scaleY="1.12">
                    <path android:fillColor="#FFFFFF" android:pathData="M-11,-7.5a4,4 0,0 1,4 -4h14a4,4 0,0 1,4 4v7a4,4 0,0 1,-4 4h-8l-5.5,5l1,-5h-1.5a4,4 0,0 1,-4 -4z" />
                </group>
                <!-- 빨간 말풍선 -->
                <path android:pathData="M-11,-7.5a4,4 0,0 1,4 -4h14a4,4 0,0 1,4 4v7a4,4 0,0 1,-4 4h-8l-5.5,5l1,-5h-1.5a4,4 0,0 1,-4 -4z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="linear" android:startX="0" android:startY="-8" android:endX="0" android:endY="8">
                            <item android:offset="0" android:color="#FFFF6B5E" />
                            <item android:offset="1" android:color="#FFD32F2F" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- D-1 (글꼴 대신 선으로 그림) -->
                <group android:translateY="-4" android:scaleX="0.72" android:scaleY="0.72">
                    <path android:strokeColor="#FFFFFF" android:strokeWidth="2.2" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M-9,-5v10h2.2a5,5 0,0 0,0 -10z" />
                    <path android:strokeColor="#FFFFFF" android:strokeWidth="2.2" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M0,0.3h3.4" />
                    <path android:strokeColor="#FFFFFF" android:strokeWidth="2.2" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M6.6,-3.2l2.2,-1.8v10" />
                </group>
            </group>
        </group>
    </group>
</vector>
