<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 아이콘 배경: 살구색 → 망고색 그라데이션 + 왼쪽 위 빛 번짐 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 왼쪽 위(밝은 살구색) → 오른쪽 아래(망고색) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="22" android:startY="18" android:endX="86" android:endY="92">
                <item android:offset="0" android:color="#FFFFE7B8" />
                <item android:offset="1" android:color="#FFFFB547" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 왼쪽 위 빛 번짐 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="30" android:centerY="24" android:gradientRadius="50">
                <item android:offset="0" android:color="#99FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
